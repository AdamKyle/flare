{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "bkwld/cloner": "3.15.0",
        "christianessl/landmap-generation": "1.0.0",
        "deployer/deployer": "v7.5.12",
        "guzzlehttp/guzzle": "7.15.3",
        "intervention/image": "4.3.0",
        "knplabs/github-api": "v3.16.1",
        "laravel/framework": "13.26.1",
        "laravel/horizon": "5.48.3",
        "laravel/reverb": "1.11.1",
        "laravel/tinker": "3.0.2",
        "laravel/ui": "4.6.3",
        "league/commonmark": "2.10.0",
        "league/fractal": "0.21",
        "maatwebsite/excel": "4.0.1",
        "spatie/laravel-permission": "8.3.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "3.7.0",
        "fakerphp/faker": "1.24.1",
        "laravel/pint": "1.30.5",
        "mockery/mockery": "1.6.12",
        "nunomaduro/collision": "8.9.5",
        "pestphp/pest": "5.1.1",
        "pestphp/pest-plugin-laravel": "5.0.1",
        "phpunit/phpunit": "13.3.0",
        "spatie/laravel-ignition": "2.12.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "php-http/discovery": false,
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "phpunit": "./vendor/bin/phpunit --stop-on-error --stop-on-failure --coverage-html=./test-coverage",
        "format": "./vendor/bin/pint"
    }
}
